@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title ResearcherCrm Service Components\n(runtime versions: docs/architecture-overview.md §1)

Container(researcher_crm, "ResearcherCrm", "PHP, Symfony")

Boundary(researcher_boundary, "Job Search & CRM") {
    Component(presentation, "Presentation Layer", "Controllers", "REST API")
    Component(application, "Application Layer", "Commands/Queries", "Profile, desired jobs, replies, meetings, analytics")
    Component(domain, "Domain Layer", "Entities, Aggregates", "Researcher (root), Reply, Meet, Message, AIRecommendation, Desired Job")
    Component(infrastructure, "Infrastructure Layer", "Doctrine, Event bus", "PostgreSQL, Redis, RabbitMQ")
    Component(audit, "Audit Logger", "Listens to events", "Append-only store")

    Rel(presentation, application, "Calls")
    Rel(application, domain, "Uses")
    Rel(application, infrastructure, "Saves / publishes")
    Rel(domain, audit, "Publishes audit events")
}

ContainerDb(postgres, "PostgreSQL", "Researcher DB")
Container(rabbitmq, "RabbitMQ", "Messages")
Container(redis, "Redis", "Cache, sessions")

Rel(researcher_crm, postgres, "Reads / writes")
Rel(researcher_crm, rabbitmq, "Publishes and consumes")
Rel(researcher_crm, redis, "Caches")

@enduml
