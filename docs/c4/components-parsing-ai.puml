@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Parsing&AIConnector Service Components\n(runtime versions: docs/architecture-overview.md §1)

Container(parsing_ai, "Parsing&AIConnector", "Python, FastAPI, Celery")

Boundary(parsing_ai_boundary, "AI & Parsing") {
    Component(presentation, "Presentation Layer", "FastAPI routes", "Accepts commands and requests")
    Component(application, "Application Layer", "Use cases", "Parsing runs, AI generation, RAG")
    Component(domain, "Domain Layer", "Entities, Aggregates", "ParsingTask, AIRecommendationTask, VacancyCandidate, AIModel")
    Component(acl_parsing, "Parsing ACL", "Adapter for portals", "Parses HTML/JSON")
    Component(acl_ai, "AI Provider Interface", "Port; Ollama / OpenAI adapters", "Generates AI responses")
    Component(rag, "RAG Pipeline", "Chunking, embeddings, retrieval", "Uses Qdrant")
    Component(celery_worker, "Celery Worker", "Async tasks", "Parsing, AI generation")

    Rel(presentation, application, "Calls")
    Rel(application, domain, "Uses")
    Rel(application, acl_parsing, "Parses through")
    Rel(application, acl_ai, "Generates through")
    Rel(application, rag, "Retrieves context through")
    Rel(celery_worker, application, "Triggers")
}

ContainerDb(qdrant, "Qdrant", "Vector DB")
Container(rabbitmq, "RabbitMQ", "Task queues and messages")
Container(redis, "Redis", "AI response cache")

System_Ext(portal, "External portals (LinkedIn, Djinni)")
System_Ext(ai_provider, "AI providers (OpenAI, Ollama)")

Rel(parsing_ai, qdrant, "Indexes and searches")
Rel(parsing_ai, rabbitmq, "Publishes and consumes")
Rel(parsing_ai, redis, "Caches")

Rel(acl_parsing, portal, "Parses", "HTTPS")
Rel(acl_ai, ai_provider, "Calls", "HTTPS/HTTP")

@enduml
