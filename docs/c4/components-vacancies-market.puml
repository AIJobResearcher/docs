@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Vacancy Management Service Components\n(runtime versions: docs/architecture-overview.md §1)

Container(vacancies, "Vacancies Market", "PHP, Laravel")

Boundary(vacancies_boundary, "Vacancy Management") {
    Component(presentation, "Presentation Layer", "Controllers", "Handles HTTP requests")
    Component(application, "Application Layer", "Commands/Queries", "Orchestrates use cases")
    Component(domain, "Domain Layer", "Entities, Aggregates", "Employer (root), Vacancy, Interviewer, Job, Requirement, Location, Source, Content, PortalCandidate, EntityMapping")
    Component(infrastructure, "Infrastructure Layer", "Repositories, Event publishers", "PostgreSQL, Redis, RabbitMQ, OpenSearch")

    Rel(presentation, application, "Calls")
    Rel(application, domain, "Uses")
    Rel(application, infrastructure, "Saves / publishes")
}

ContainerDb(postgres, "PostgreSQL", "Vacancies DB")
Container(rabbitmq, "RabbitMQ", "Messages")
Container(redis, "Redis", "Cache")
Container(opensearch, "OpenSearch", "Search index")

Rel(vacancies, postgres, "Reads / writes")
Rel(vacancies, rabbitmq, "Publishes and consumes")
Rel(vacancies, redis, "Caches")
Rel(vacancies, opensearch, "Indexes")

@enduml
