@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Frontend Components

Container(frontend, "Frontend", "React 19.2 / Next.js 16.3")

Boundary(frontend_boundary, "Frontend") {
    Component(pages, "Pages & Routes", "Next.js 16.3 App Router", "Routing, layout and auth guard")
    Component(components, "UI Components", "React", "Buttons, forms, cards")
    Component(server_state, "Server-state Cache", "Data fetching", "Vacancies and desired jobs")
    Component(api_client, "API Client", "Generated from OpenAPI", "Typed backend calls")

    Rel(pages, components, "Uses")
    Rel(pages, server_state, "Uses")
    Rel(server_state, api_client, "Calls")
}

System_Ext(backend, "Vacancies Market, ResearcherCrm", "Backend services")

Rel(frontend, backend, "HTTP", "REST API")

@enduml
