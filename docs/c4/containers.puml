@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title AIJobResearcher Container Diagram\n(runtime versions: docs/architecture-overview.md §1)

Person(seeker, "Job seeker")

System_Boundary(platform, "AIJobResearcher") {
    Container(frontend, "Frontend", "React, Next.js", "User interface")
    Container(vacancies, "Vacancies Market", "PHP, Laravel", "Vacancy catalogue: employers, vacancies, jobs, interviewers, locations")
    Container(researcher_crm, "ResearcherCrm", "PHP, Symfony", "Job seeker profile, desired jobs, replies, meetings, messages, analytics")
    Container(parsing_ai, "Parsing&AIConnector", "Python, FastAPI, Celery", "Portal parsing, AI recommendations, RAG")
    Container(knowledge, "KnowledgeCenter", "Go, Gin", "Learning tracks, progress, development recommendations")

    ContainerDb(postgres_v, "PostgreSQL", "Vacancies DB")
    ContainerDb(postgres_r, "PostgreSQL", "Researcher DB")
    ContainerDb(postgres_k, "PostgreSQL", "Knowledge DB")
    ContainerDb(postgres_p, "PostgreSQL", "Parser DB: watches, snapshots, tasks")
    ContainerDb(redis, "Redis", "Cache, sessions, rate limiting")
    Container(rabbitmq, "RabbitMQ", "Message broker")
    Container(opensearch, "OpenSearch", "Search engine")
    Container(qdrant, "Qdrant", "Vector DB for RAG (quantized)")
}

System_Ext(portal, "External portals (LinkedIn, Djinni)")
System_Ext(ai_provider, "AI provider (DeepSeek API)")
System_Ext(embeddings_api, "Embeddings API (provider TBD)")
System_Ext(google_calendar, "Google Calendar")

Rel(seeker, frontend, "Uses", "REST")
Rel(frontend, vacancies, "Requests", "REST")
Rel(frontend, researcher_crm, "Requests", "REST")

Rel(vacancies, postgres_v, "Reads/writes", "SQL")
Rel(researcher_crm, postgres_r, "Reads/writes", "SQL")
Rel(knowledge, postgres_k, "Reads/writes", "SQL")
Rel(parsing_ai, postgres_p, "Reads/writes", "SQL")

Rel(vacancies, redis, "Caches")
Rel(researcher_crm, redis, "Caches, sessions")
Rel(parsing_ai, redis, "Caches AI responses")

Rel(vacancies, rabbitmq, "Publishes and consumes")
Rel(researcher_crm, rabbitmq, "Publishes and consumes")
Rel(parsing_ai, rabbitmq, "Publishes and consumes")
Rel(knowledge, rabbitmq, "Publishes and consumes")

Rel(vacancies, opensearch, "Indexes")
Rel(parsing_ai, qdrant, "Indexes and searches")

Rel(parsing_ai, portal, "Parses", "HTTPS")
Rel(parsing_ai, ai_provider, "Generates through", "HTTPS")
Rel(parsing_ai, embeddings_api, "Embeds through", "HTTPS")
Rel(researcher_crm, google_calendar, "Creates events", "HTTPS")

@enduml
